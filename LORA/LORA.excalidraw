    {
      "id": "c6_FnXXsBKZsF8SFk6hOj",
      "type": "text",
      "x": 272,
      "y": 397.1929931640625,
      "width": 702,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b53",
      "roundness": null,
      "seed": 401770006,
      "version": 537,
      "versionNonce": 866740502,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1740934470642,
      "link": null,
      "locked": false,
      "text": "Problems with fine-tuning\n1. Models are very large. Finetuning large networks is expensive \nfor average developer or researcher\n2. Storage requirements - checkpoints at different number of iterations\nmay have to be saved [saving optimiser state adds to the woes]\n3. Finetuning is usually task specific. So we will end up having multiple \ncopies of the original model.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problems with fine-tuning\n1. Models are very large. Finetuning large networks is expensive \nfor average developer or researcher\n2. Storage requirements - checkpoints at different number of iterations\nmay have to be saved [saving optimiser state adds to the woes]\n3. Finetuning is usually task specific. So we will end up having multiple \ncopies of the original model.",
      "autoResize": false,
      "lineHeight": 1.25
    },
