      "versionNonce": 137707176,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1742639950578,
      "link": null,
      "locked": false,
      "text": "in gpu, computations are faster and it takes higher time to move data\naround between host and device. multi-query attention and gqa try to solve\nthis problem but reducing the amount of data to held in memory at a time.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "in gpu, computations are faster and it takes higher time to move data around between host and device. multi-query attention and gqa try to solve this problem but reducing the amount of data to held in memory at a time.",
      "autoResize": false,
      "lineHeight": 1.25
    },
